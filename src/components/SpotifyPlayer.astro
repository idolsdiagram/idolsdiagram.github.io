---
import { Badge } from "./ui/badge";
import { Card } from "./ui/card";
const { data } = Astro.props;
---

{data && (
  <section class="mx-auto max-w-3xl space-y-4">
    <Card className="border bg-card py-0">
      <iframe
        class="block w-full rounded-xl"
        src={`https://open.spotify.com/embed/artist/${data.id}?utm_source=generator`}
        width="100%"
        height="352"
        frameborder="0"
        allowfullscreen=""
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        title="Spotify artist player"
      />
    </Card>
    <div class="flex flex-wrap justify-end gap-2">
      <div class="inline-flex items-center gap-2 rounded-lg border bg-card px-3 py-2 text-sm">
        <span class="text-muted-foreground">Popularity</span><Badge>{data.popularity}</Badge>
      </div>
      <div class="inline-flex items-center gap-2 rounded-lg border bg-card px-3 py-2 text-sm">
        <span class="text-muted-foreground">Followers</span><Badge variant="secondary">{data.followers.toLocaleString()}</Badge>
      </div>
    </div>
  </section>
)}
